# Night / Cortex
NODE_ENV=production
# Bot-Hosting injects SERVER_PORT automatically. Do not set a fixed hosted port here.
CORTEX_API_TOKEN=
OWNER_NUMBER=

# WhatsApp identities. Roles are configured separately.
WHATSAPP_SESSIONS=main,assistant
WHATSAPP_ROLE_MODE=split
WHATSAPP_INBOX_SESSION=main
WHATSAPP_AI_SESSION=assistant
WHATSAPP_FALLBACK_ENABLED=true

# Pre-Cortex live pairing test.
PAIRING_SESSION=main
PAIRING_PHONE_NUMBER=

# Optional emergency override only. Normally leave blank and let Lia's fork choose.
NIGHT_WA_VERSION=

# AI
AI_ENABLED=true
AI_DEFAULT_ROUTE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MONTHLY_CAP_USD=2

# Groq: use either GROQ_API_KEY or a comma/newline-separated GROQ_API_KEYS list.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=groq/compound-mini
GROQ_MAX_TOKENS=1800

# Azure AI resource
AZURE_CORE_ENDPOINT=
AZURE_CORE_KEY=
AZURE_CORE_KEY_2=
AZURE_CORE_REGION=
AZURE_PHI_DEPLOYMENT=

# Azure Speech
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AZURE_TTS_VOICE=en-NG-AbeoNeural

# Azure Vision
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Separate image-generation resource/deployment
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_KEY=
AZURE_IMAGE_REGION=
AZURE_IMAGE_DEPLOYMENT=

# Blob storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Media search
TENOR_API_KEY=

# Manga / media
SUWAYOMI_BASE_URL=
SUWAYOMI_USERNAME=
SUWAYOMI_PASSWORD=
