# Night / Cortex
NODE_ENV=production
PORT=8787
CORTEX_API_TOKEN=
OWNER_NUMBER=

# WhatsApp identities. Roles are configured separately.
WHATSAPP_SESSIONS=main,assistant
WHATSAPP_ROLE_MODE=split
WHATSAPP_INBOX_SESSION=main
WHATSAPP_AI_SESSION=assistant
WHATSAPP_FALLBACK_ENABLED=true
# Optional emergency override only. Normally leave blank and let Lia's fork choose.
NIGHT_WA_VERSION=

# AI
AI_ENABLED=true
AI_DEFAULT_ROUTE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MONTHLY_CAP_USD=2
GROQ_API_KEYS=

# Azure AI resource (one resource can back Foundry/Speech/Vision/Language)
AZURE_CORE_ENDPOINT=
AZURE_CORE_KEY=
AZURE_CORE_KEY_2=
AZURE_CORE_REGION=
AZURE_PHI_DEPLOYMENT=

# Separate image-generation resource/deployment when hosted in a different region
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_KEY=
AZURE_IMAGE_REGION=
AZURE_IMAGE_DEPLOYMENT=

# Blob storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Manga / media
SUWAYOMI_BASE_URL=
SUWAYOMI_USERNAME=
SUWAYOMI_PASSWORD=
